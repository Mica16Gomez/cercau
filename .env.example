# En la notebook, con la API local: http://localhost:3000
# En el emulador Android: http://10.0.2.2:3000
# En un teléfono físico: http://IP-DE-LA-NOTEBOOK:3000 (misma Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:3000
# false = intenta la API del profesor y, si no responde, usa mocks.
# true = fuerza los comercios de demostración (útil si no vas a levantar el backend).
EXPO_PUBLIC_DIRECTORIO_MOCKS=false
